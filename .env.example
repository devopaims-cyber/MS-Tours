# =====================================================================
# MS Tours & Travels — development environment
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — never commit it.
# =====================================================================

# --- Server ---------------------------------------------------------
NODE_ENV=development
PORT=5000

# --- MongoDB --------------------------------------------------------
# Local (default):   mongodb://127.0.0.1:27017/ms_tours
# Atlas:   mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<cluster>.mongodb.net/ms_tours?retryWrites=true&w=majority
#
# WHERE TO GET THIS (Atlas):
#   1. https://cloud.mongodb.com → your project → Database → Connect
#   2. "Drivers" → Node.js driver → copy the string it shows.
#   3. The path MUST include the DB name (e.g. /ms_tours) before the ?
#   4. Network Access → add 0.0.0.0/0 (dev) or your IP.
MONGO_URI=mongodb://127.0.0.1:27017/ms_tours

# --- Auth -----------------------------------------------------------
# Long random string in production. `openssl rand -hex 32` is fine.
JWT_SECRET=replace_me_with_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# --- Redis (optional — app runs without it) ------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- CORS origin ----------------------------------------------------
CLIENT_URL=http://localhost:5173

# --- Client ---------------------------------------------------------
# Read by Vite at build time. Prefix must be VITE_.
VITE_API_URL=http://localhost:5000/api

# =====================================================================
# Travelport uAPI integration
# Without these set, the live-flight features run in "stub" mode and
# return canned data so you can develop without credentials.
#
# WHERE TO GET THESE:
#   1. Sign up for uAPI at https://developer.travelport.com
#   2. Apply for a PCC (Pseudo City Code) + target branch from
#      your Travelport account manager.
#   3. Issue a username/password with API permissions.
#   4. Decide auth scheme:
#        - oauth  : modern OAuth2 client-credentials (recommended)
#        - wsse   : legacy WS-Security UsernameToken
#
# MODES:
#   demo  → never call Travelport; only show the seeded catalog
#   stub  → return fixture data (no creds needed)         ← DEFAULT when creds missing
#   live  → actually call apicert.travelport.com (cert) or apis.travelport.com (prod)
# =====================================================================
TRAVELPORT_MODE=demo
TRAVELPORT_ENV=cert
TRAVELPORT_AUTH=oauth
TRAVELPORT_USERNAME=
TRAVELPORT_PASSWORD=
TRAVELPORT_PCC=
TRAVELPORT_TARGET_BRANCH=
TRAVELPORT_APIKEY=
TRAVELPORT_TOKEN_URL=
TRAVELPORT_ENDPOINT_URL=
